1
00:00:00,010 --> 00:00:03,890
المُوَلِّدُ والاسْتِقْلالُ الخَطِّيّ.

2
00:00:03,900 --> 00:00:06,346
المُوَلِّدُ سُؤالُ وُصول:

3
00:00:06,356 --> 00:00:10,692
إلى أيْنَ تَصِل؟ والاسْتِقْلالُ سُؤالُ هَدَر:

4
00:00:10,702 --> 00:00:12,944
هَلْ مِنْ مُتَّجِهٍ زائِد؟

5
00:00:12,944 --> 00:00:16,920
المُوَلِّدُ هو كُلُّ التَّراكيبِ المُمْكِنة.

6
00:00:16,930 --> 00:00:20,711
مُوَلِّدُ واحِدٍ وصِفْر مَعَ صِفْرٍ وواحِدٍ هو

7
00:00:20,721 --> 00:00:25,368
المُسْتَوى كُلُّه: أيُّ نُقْطةٍ
تَصِلُ إلَيْها بِأوْزانٍ

8
00:00:25,378 --> 00:00:25,936
مُناسِبة.

9
00:00:25,936 --> 00:00:30,140
ولِلزَّوْجِ في المُسْتَوى اخْتِبارٌ فَوْريّ:

10
00:00:30,150 --> 00:00:34,738
المُحَدِّد. واحِدٌ وواحِدٌ
مَعَ اثْنَيْنِ واثْنَيْن:

11
00:00:34,748 --> 00:00:38,766
المُحَدِّدُ يُساوي واحِداً في اثْنَيْن، ناقِصَ

12
00:00:38,776 --> 00:00:41,940
واحِدٍ في اثْنَيْن، يُساوي صِفْراً.

13
00:00:41,950 --> 00:00:45,274
إذَنِ المُتَّجِهانِ مُتَوازِيان، وهُما

14
00:00:45,284 --> 00:00:46,152
مُرْتَبِطان.

15
00:00:46,152 --> 00:00:50,287
والتَّعْريفُ الدَّقيقُ بِمُعادَلةِ الصِّفْر:

16
00:00:50,297 --> 00:00:53,817
اثْنان في واحِدٍ وواحِد، ناقِصُ واحِدٍ في

17
00:00:53,827 --> 00:00:57,141
اثْنَيْنِ واثْنَيْن، يُساوي الصِّفْر —

18
00:00:57,151 --> 00:00:59,662
بِأوْزانٍ غَيْرِ صِفْرِيَّة.

19
00:00:59,672 --> 00:01:01,664
إذَنِ الارْتِباطُ مُثْبَت.

20
00:01:01,664 --> 00:01:07,386
وقاعِدةٌ أخيرة: أيُّ مَجْموعةٍ
تَحْوي المُتَّجِهَ الصِّفْرِيَّ

21
00:01:07,396 --> 00:01:10,860
مُرْتَبِطةٌ حَتْماً — فَوَزْنُهُ واحِد،

22
00:01:10,870 --> 00:01:14,335
وبَقِيَّةُ الأوْزانِ أصْفار، فَتَصْنَعُ

23
00:01:14,345 --> 00:01:16,991
الصِّفْر. الدَّرْسُ الثّامِن:

24
00:01:17,001 --> 00:01:17,560
لا هَدَر.

