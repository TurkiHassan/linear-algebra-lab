1
00:00:00,010 --> 00:00:05,198
المُحَدِّد: رَقَمٌ واحِدٌ
يَكْشِفُ ثَلاثةَ أسْرار:

2
00:00:05,208 --> 00:00:10,098
هَلْ يُوجَدُ نَظير؟ وهَلِ
الأعْمِدةُ مُسْتَقِلَّة؟

3
00:00:10,108 --> 00:00:13,064
وهَلِ المِساحةُ غَيْرُ مُسَطَّحة؟

4
00:00:13,064 --> 00:00:16,100
مُحَدِّدُ اثْنَيْنِ في اثْنَيْن:

5
00:00:16,110 --> 00:00:19,781
اضْرِبْ القُطْرَ الرَّئيسيَّ واطْرَحْ حاصِلَ

6
00:00:19,791 --> 00:00:24,756
القُطْرِ الآخَر. اثْنان في
اثْنَيْن، ناقِص، واحِد في سالِبِ

7
00:00:24,766 --> 00:00:26,713
ثَلاثة، يُساوي سَبْعة.

8
00:00:26,723 --> 00:00:29,814
غَيْرُ صِفْرِيّ، فَالنَّظيرُ مَوْجودٌ

9
00:00:29,824 --> 00:00:31,719
والأعْمِدةُ مُسْتَقِلَّة.

10
00:00:31,719 --> 00:00:36,860
وهَنْدَسِيّاً: عَمودا
المَصْفوفةِ ضِلْعا مُتَوازي

11
00:00:36,870 --> 00:00:40,381
أضْلاع، ومِساحَتُهُ تُساوي القيمَةَ

12
00:00:40,391 --> 00:00:42,876
المُطْلَقةَ لِلمُحَدِّد.

13
00:00:42,886 --> 00:00:43,847
هُنا سَبْعة.

14
00:00:43,847 --> 00:00:47,610
ولِلرُّتْبَةِ ثَلاثة: قاعِدةُ ساروس.

15
00:00:47,620 --> 00:00:51,022
انْسَخْ عَمودَيْن، واجْمَعْ حَواصِلَ

16
00:00:51,032 --> 00:00:55,140
الأقْطارِ النّازِلة، ثُمَّ اطْرَحْ حَواصِلَ

17
00:00:55,150 --> 00:01:00,755
الأقْطارِ الصّاعِدة. ثَلاثون،
ناقِصُ سالِبِ أرْبَعةَ عَشَر،

18
00:01:00,765 --> 00:01:03,031
يُساوي أرْبَعةً وأرْبَعين.

19
00:01:03,031 --> 00:01:09,118
ومُحَدِّدُ الصِّفْر؟ ثَلاثةُ
أحْكامٍ سَلْبِيَّةٍ دَفْعةً

20
00:01:09,128 --> 00:01:13,419
واحِدة: بِلا نَظير، وأعْمِدةٌ مُرْتَبِطة،

21
00:01:13,429 --> 00:01:17,463
ومِساحةٌ مُسَطَّحة. الدَّرْسُ العاشِر:

22
00:01:17,473 --> 00:01:18,903
الصِّفْرُ حاسِم.

